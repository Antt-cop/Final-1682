# CanteenB2B Environment Configuration
# Copy this file to .env and adjust the values as needed for your environment.

# ── Application ───────────────────────────────────────────────
APP_ENV=local
APP_DEBUG=true
APP_URL=
# ── Database ──────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dongkhoistore
DB_USERNAME=root
DB_PASSWORD=
GHN_API_URL=

# ── Mail / SMTP ───────────────────────────────────────────────
# (Currently managed via database table 'smtp_settings' in Admin panel)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=hello@example.com
# MAIL_FROM_NAME="${APP_NAME}"

# ── APIs / Integrations ───────────────────────────────────────
# GHN Integration (Express Logistics)
# (Currently managed via database table 'ghn_shops')
# GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api/v2

